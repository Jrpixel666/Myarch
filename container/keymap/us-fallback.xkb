// A compact, self-contained XKB keymap for the Myarch compositor.
//
// Wayland requires the compositor to hand every keyboard client a compiled
// keymap, and clients block until they get one. The real keymap is generated
// inside the container by `xkbcli compile-keymap` once xkeyboard-config is
// installed (see container/scripts/generate-keymap.sh); this file is the
// fallback used before that happens -- during the install, and on the first
// boot of a container where the package is missing.
//
// It is deliberately self-contained: it uses no `include` directives, because
// the client resolves includes against *its* xkb data path and we cannot rely
// on that existing. US layout only; everything else comes from the container.
//
// Generated by tools/make-fallback-keymap.py -- do not edit by hand.
xkb_keymap {
xkb_keycodes "myarch" {
    minimum = 8;
    maximum = 255;
    <ESC> = 9;
    <AE01> = 10;
    <AE02> = 11;
    <AE03> = 12;
    <AE04> = 13;
    <AE05> = 14;
    <AE06> = 15;
    <AE07> = 16;
    <AE08> = 17;
    <AE09> = 18;
    <AE10> = 19;
    <AE11> = 20;
    <AE12> = 21;
    <BKSP> = 22;
    <TAB> = 23;
    <AD01> = 24;
    <AD02> = 25;
    <AD03> = 26;
    <AD04> = 27;
    <AD05> = 28;
    <AD06> = 29;
    <AD07> = 30;
    <AD08> = 31;
    <AD09> = 32;
    <AD10> = 33;
    <AD11> = 34;
    <AD12> = 35;
    <RTRN> = 36;
    <LCTL> = 37;
    <AC01> = 38;
    <AC02> = 39;
    <AC03> = 40;
    <AC04> = 41;
    <AC05> = 42;
    <AC06> = 43;
    <AC07> = 44;
    <AC08> = 45;
    <AC09> = 46;
    <AC10> = 47;
    <AC11> = 48;
    <TLDE> = 49;
    <LFSH> = 50;
    <BKSL> = 51;
    <AB01> = 52;
    <AB02> = 53;
    <AB03> = 54;
    <AB04> = 55;
    <AB05> = 56;
    <AB06> = 57;
    <AB07> = 58;
    <AB08> = 59;
    <AB09> = 60;
    <AB10> = 61;
    <RTSH> = 62;
    <KPMU> = 63;
    <LALT> = 64;
    <SPCE> = 65;
    <CAPS> = 66;
    <FK01> = 67;
    <FK02> = 68;
    <FK03> = 69;
    <FK04> = 70;
    <FK05> = 71;
    <FK06> = 72;
    <FK07> = 73;
    <FK08> = 74;
    <FK09> = 75;
    <FK10> = 76;
    <NMLK> = 77;
    <SCLK> = 78;
    <KP7> = 79;
    <KP8> = 80;
    <KP9> = 81;
    <KP4> = 83;
    <KP5> = 84;
    <KP6> = 85;
    <KP1> = 87;
    <KP2> = 88;
    <KP3> = 89;
    <KP0> = 90;
    <KPDL> = 91;
    <KPSU> = 82;
    <KPAD> = 86;
    <FK11> = 95;
    <FK12> = 96;
    <KPEN> = 104;
    <RCTL> = 105;
    <KPDV> = 106;
    <PRSC> = 107;
    <RALT> = 108;
    <HOME> = 110;
    <UP> = 111;
    <PGUP> = 112;
    <LEFT> = 113;
    <RGHT> = 114;
    <END> = 115;
    <DOWN> = 116;
    <PGDN> = 117;
    <INS> = 118;
    <DELE> = 119;
    <PAUS> = 127;
    <LWIN> = 133;
    <RWIN> = 134;
    <COMP> = 135;
    indicator 1 = "Caps Lock";
    indicator 2 = "Num Lock";
    indicator 3 = "Scroll Lock";
};

xkb_types "myarch" {
    virtual_modifiers NumLock,Alt,LevelThree,Super,Meta;

    type "ONE_LEVEL" {
        modifiers = none;
        map[none] = Level1;
        level_name[Level1] = "Any";
    };

    type "TWO_LEVEL" {
        modifiers = Shift;
        map[none] = Level1;
        map[Shift] = Level2;
        level_name[Level1] = "Base";
        level_name[Level2] = "Shift";
    };

    // Caps Lock and Shift both reach level 2, which is what makes typed
    // letters follow Caps Lock without affecting punctuation.
    type "ALPHABETIC" {
        modifiers = Shift+Lock;
        map[none] = Level1;
        map[Shift] = Level2;
        map[Lock] = Level2;
        map[Shift+Lock] = Level1;
        level_name[Level1] = "Base";
        level_name[Level2] = "Caps";
    };

    type "KEYPAD" {
        modifiers = Shift+NumLock;
        map[none] = Level1;
        map[Shift] = Level2;
        map[NumLock] = Level2;
        map[Shift+NumLock] = Level1;
        level_name[Level1] = "Base";
        level_name[Level2] = "Number";
    };
};

xkb_compatibility "myarch" {
    virtual_modifiers NumLock,Alt,LevelThree,Super,Meta;

    interpret.useModMapMods = AnyLevel;
    interpret.repeat = False;

    interpret Shift_L+AnyOfOrNone(all) {
        action = SetMods(modifiers=Shift, clearLocks);
    };
    interpret Shift_R+AnyOfOrNone(all) {
        action = SetMods(modifiers=Shift, clearLocks);
    };
    interpret Control_L+AnyOfOrNone(all) {
        action = SetMods(modifiers=Control, clearLocks);
    };
    interpret Control_R+AnyOfOrNone(all) {
        action = SetMods(modifiers=Control, clearLocks);
    };
    interpret Caps_Lock+AnyOfOrNone(all) {
        action = LockMods(modifiers=Lock);
    };
    interpret Num_Lock+AnyOfOrNone(all) {
        virtualModifier = NumLock;
        action = LockMods(modifiers=NumLock);
    };
    interpret Alt_L+AnyOfOrNone(all) {
        virtualModifier = Alt;
        action = SetMods(modifiers=modMapMods, clearLocks);
    };
    interpret Alt_R+AnyOfOrNone(all) {
        virtualModifier = Alt;
        action = SetMods(modifiers=modMapMods, clearLocks);
    };
    interpret ISO_Level3_Shift+AnyOfOrNone(all) {
        virtualModifier = LevelThree;
        action = SetMods(modifiers=modMapMods, clearLocks);
    };
    interpret Super_L+AnyOfOrNone(all) {
        virtualModifier = Super;
        action = SetMods(modifiers=modMapMods, clearLocks);
    };
    interpret Super_R+AnyOfOrNone(all) {
        virtualModifier = Super;
        action = SetMods(modifiers=modMapMods, clearLocks);
    };

    indicator "Caps Lock" {
        whichModState = Locked;
        modifiers = Lock;
    };
    indicator "Num Lock" {
        whichModState = Locked;
        modifiers = NumLock;
    };
};

xkb_symbols "myarch" {
    name[Group1] = "English (US)";

    key <ESC> { type = "ONE_LEVEL", [ Escape ] };
    key <AE01> { type = "TWO_LEVEL", [ 1, exclam ] };
    key <AE02> { type = "TWO_LEVEL", [ 2, at ] };
    key <AE03> { type = "TWO_LEVEL", [ 3, numbersign ] };
    key <AE04> { type = "TWO_LEVEL", [ 4, dollar ] };
    key <AE05> { type = "TWO_LEVEL", [ 5, percent ] };
    key <AE06> { type = "TWO_LEVEL", [ 6, asciicircum ] };
    key <AE07> { type = "TWO_LEVEL", [ 7, ampersand ] };
    key <AE08> { type = "TWO_LEVEL", [ 8, asterisk ] };
    key <AE09> { type = "TWO_LEVEL", [ 9, parenleft ] };
    key <AE10> { type = "TWO_LEVEL", [ 0, parenright ] };
    key <AE11> { type = "TWO_LEVEL", [ minus, underscore ] };
    key <AE12> { type = "TWO_LEVEL", [ equal, plus ] };
    key <BKSP> { type = "ONE_LEVEL", [ BackSpace ] };
    key <TAB> { type = "TWO_LEVEL", [ Tab, ISO_Left_Tab ] };
    key <AD01> { type = "ALPHABETIC", [ q, Q ] };
    key <AD02> { type = "ALPHABETIC", [ w, W ] };
    key <AD03> { type = "ALPHABETIC", [ e, E ] };
    key <AD04> { type = "ALPHABETIC", [ r, R ] };
    key <AD05> { type = "ALPHABETIC", [ t, T ] };
    key <AD06> { type = "ALPHABETIC", [ y, Y ] };
    key <AD07> { type = "ALPHABETIC", [ u, U ] };
    key <AD08> { type = "ALPHABETIC", [ i, I ] };
    key <AD09> { type = "ALPHABETIC", [ o, O ] };
    key <AD10> { type = "ALPHABETIC", [ p, P ] };
    key <AD11> { type = "TWO_LEVEL", [ bracketleft, braceleft ] };
    key <AD12> { type = "TWO_LEVEL", [ bracketright, braceright ] };
    key <RTRN> { type = "ONE_LEVEL", [ Return ] };
    key <LCTL> { type = "ONE_LEVEL", [ Control_L ] };
    key <AC01> { type = "ALPHABETIC", [ a, A ] };
    key <AC02> { type = "ALPHABETIC", [ s, S ] };
    key <AC03> { type = "ALPHABETIC", [ d, D ] };
    key <AC04> { type = "ALPHABETIC", [ f, F ] };
    key <AC05> { type = "ALPHABETIC", [ g, G ] };
    key <AC06> { type = "ALPHABETIC", [ h, H ] };
    key <AC07> { type = "ALPHABETIC", [ j, J ] };
    key <AC08> { type = "ALPHABETIC", [ k, K ] };
    key <AC09> { type = "ALPHABETIC", [ l, L ] };
    key <AC10> { type = "TWO_LEVEL", [ semicolon, colon ] };
    key <AC11> { type = "TWO_LEVEL", [ apostrophe, quotedbl ] };
    key <TLDE> { type = "TWO_LEVEL", [ grave, asciitilde ] };
    key <LFSH> { type = "ONE_LEVEL", [ Shift_L ] };
    key <BKSL> { type = "TWO_LEVEL", [ backslash, bar ] };
    key <AB01> { type = "ALPHABETIC", [ z, Z ] };
    key <AB02> { type = "ALPHABETIC", [ x, X ] };
    key <AB03> { type = "ALPHABETIC", [ c, C ] };
    key <AB04> { type = "ALPHABETIC", [ v, V ] };
    key <AB05> { type = "ALPHABETIC", [ b, B ] };
    key <AB06> { type = "ALPHABETIC", [ n, N ] };
    key <AB07> { type = "ALPHABETIC", [ m, M ] };
    key <AB08> { type = "TWO_LEVEL", [ comma, less ] };
    key <AB09> { type = "TWO_LEVEL", [ period, greater ] };
    key <AB10> { type = "TWO_LEVEL", [ slash, question ] };
    key <RTSH> { type = "ONE_LEVEL", [ Shift_R ] };
    key <KPMU> { type = "ONE_LEVEL", [ KP_Multiply ] };
    key <LALT> { type = "ONE_LEVEL", [ Alt_L ] };
    key <SPCE> { type = "ONE_LEVEL", [ space ] };
    key <CAPS> { type = "ONE_LEVEL", [ Caps_Lock ] };
    key <FK01> { type = "ONE_LEVEL", [ F1 ] };
    key <FK02> { type = "ONE_LEVEL", [ F2 ] };
    key <FK03> { type = "ONE_LEVEL", [ F3 ] };
    key <FK04> { type = "ONE_LEVEL", [ F4 ] };
    key <FK05> { type = "ONE_LEVEL", [ F5 ] };
    key <FK06> { type = "ONE_LEVEL", [ F6 ] };
    key <FK07> { type = "ONE_LEVEL", [ F7 ] };
    key <FK08> { type = "ONE_LEVEL", [ F8 ] };
    key <FK09> { type = "ONE_LEVEL", [ F9 ] };
    key <FK10> { type = "ONE_LEVEL", [ F10 ] };
    key <NMLK> { type = "ONE_LEVEL", [ Num_Lock ] };
    key <SCLK> { type = "ONE_LEVEL", [ Scroll_Lock ] };
    key <KP7> { type = "KEYPAD", [ KP_Home, KP_7 ] };
    key <KP8> { type = "KEYPAD", [ KP_Up, KP_8 ] };
    key <KP9> { type = "KEYPAD", [ KP_Prior, KP_9 ] };
    key <KP4> { type = "KEYPAD", [ KP_Left, KP_4 ] };
    key <KP5> { type = "KEYPAD", [ KP_Begin, KP_5 ] };
    key <KP6> { type = "KEYPAD", [ KP_Right, KP_6 ] };
    key <KP1> { type = "KEYPAD", [ KP_End, KP_1 ] };
    key <KP2> { type = "KEYPAD", [ KP_Down, KP_2 ] };
    key <KP3> { type = "KEYPAD", [ KP_Next, KP_3 ] };
    key <KP0> { type = "KEYPAD", [ KP_Insert, KP_0 ] };
    key <KPDL> { type = "KEYPAD", [ KP_Delete, KP_Decimal ] };
    key <KPSU> { type = "ONE_LEVEL", [ KP_Subtract ] };
    key <KPAD> { type = "ONE_LEVEL", [ KP_Add ] };
    key <FK11> { type = "ONE_LEVEL", [ F11 ] };
    key <FK12> { type = "ONE_LEVEL", [ F12 ] };
    key <KPEN> { type = "ONE_LEVEL", [ KP_Enter ] };
    key <RCTL> { type = "ONE_LEVEL", [ Control_R ] };
    key <KPDV> { type = "ONE_LEVEL", [ KP_Divide ] };
    key <PRSC> { type = "ONE_LEVEL", [ Print ] };
    key <RALT> { type = "ONE_LEVEL", [ ISO_Level3_Shift ] };
    key <HOME> { type = "ONE_LEVEL", [ Home ] };
    key <UP> { type = "ONE_LEVEL", [ Up ] };
    key <PGUP> { type = "ONE_LEVEL", [ Prior ] };
    key <LEFT> { type = "ONE_LEVEL", [ Left ] };
    key <RGHT> { type = "ONE_LEVEL", [ Right ] };
    key <END> { type = "ONE_LEVEL", [ End ] };
    key <DOWN> { type = "ONE_LEVEL", [ Down ] };
    key <PGDN> { type = "ONE_LEVEL", [ Next ] };
    key <INS> { type = "ONE_LEVEL", [ Insert ] };
    key <DELE> { type = "ONE_LEVEL", [ Delete ] };
    key <PAUS> { type = "ONE_LEVEL", [ Pause ] };
    key <LWIN> { type = "ONE_LEVEL", [ Super_L ] };
    key <RWIN> { type = "ONE_LEVEL", [ Super_R ] };
    key <COMP> { type = "ONE_LEVEL", [ Multi_key ] };

    modifier_map Shift { <LFSH>, <RTSH> };
    modifier_map Lock { <CAPS> };
    modifier_map Control { <LCTL>, <RCTL> };
    modifier_map Mod1 { <LALT> };
    modifier_map Mod2 { <NMLK> };
    modifier_map Mod4 { <LWIN>, <RWIN> };
    modifier_map Mod5 { <RALT> };
};
};
